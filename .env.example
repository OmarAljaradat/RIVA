# PostgreSQL Connection String from Neon / Supabase
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Admin Dashboard Password
ADMIN_PASSWORD="your_admin_password_here"

# Telegram Bot Token for Order Notifications (from @BotFather)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Telegram Chat ID to receive order alerts
TELEGRAM_ADMIN_CHAT_ID="your_telegram_chat_id"

# Base URL of the website
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 32+ characters secret for HMAC session signing
SESSION_SECRET="your_random_secret_32_characters_long"
