modules = ["nodejs-20"]
hidden = [".next", "node_modules"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "npm start"]

[workflows]
runButton = "Start"

[[workflows.workflow]]
name = "Start"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 3000 -H 0.0.0.0"
waitForPort = 3000
